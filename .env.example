# Application authentication
TICKET_LOGIN_USER=admin
TICKET_LOGIN_PASSWORD=replace-with-a-long-random-password
TICKET_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Mail worker
TICKET_MAIL_WORKER=1
TICKET_MAILBOX_SOURCE=mysql
TICKET_MAIL_POLL_SECONDS=30
TICKET_MAILBOXES_PER_CYCLE=5
TICKET_SMTP_PORT=465
TICKET_SMTP_SSL=1

# GeekForest mailbox source (read-only account recommended)
TICKET_SOURCE_DB_HOST=mysql.example.internal
TICKET_SOURCE_DB_PORT=3306
TICKET_SOURCE_DB_NAME=nxpanel
TICKET_SOURCE_DB_USER=ticket_mailbox_reader
TICKET_SOURCE_DB_PASSWORD=replace-me
TICKET_SOURCE_WORKSPACE_ID=geekforest

# Eddy mailbox source (optional)
EDDY_SOURCE_ENABLED=0
EDDY_SOURCE_DB_HOST=mysql.example.internal
EDDY_SOURCE_DB_PORT=3306
EDDY_SOURCE_DB_NAME=dev_perform
EDDY_SOURCE_DB_USER=ticket_eddy_reader
EDDY_SOURCE_DB_PASSWORD=replace-me

# Historical import (disabled by default)
TICKET_MAIL_BACKFILL=0
TICKET_MAIL_BACKFILL_INTERVAL_SECONDS=3600
TICKET_MAIL_BACKFILL_BATCH_PER_MAILBOX=50

# AI classification and translation
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_API_BASE_URL=https://api.deepseek.com
AI_API_KEY=replace-me
TICKET_AI_CLASSIFY_BATCH=5
